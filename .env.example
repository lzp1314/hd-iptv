# 复制成 .env 后按需改，docker compose 会自动读。
# 不改也能跑，下面都是默认值。
# 预构建镜像版（docker-compose.yml / .hubei.yml）和源码构建版
# （docker-compose.build.yml）都会读这个文件。

# ===== 镜像版本（只对预构建镜像版生效）=====
# latest 跟主干；想锁死写 0.9.21 或 0.9。
# 源码构建版不看这一项，它产出本地的 hd-iptv:local。
HDIPTV_IMAGE_TAG=latest

# ===== 你是湖北省内移动宽带吗 =====
# 非湖北省内用户：留着下面这行，跳过「运营商官方源」。
# 湖北省内移动宽带：直接用 docker-compose.hubei.yml，它会忽略这个变量；
# 或者在通用版里把这一行改成两条全国聚合源的名字（保留官方源、不探第三方清单）：
#   HDIPTV_SKIP_SOURCES=聚合源-公开转播,聚合源-精简线路
HDIPTV_SKIP_SOURCES=运营商官方源

# 面板会自动识别省份和运营商，识别不准时才需要手动钉死（省份写拼音）：
# HDIPTV_REGION=hubei
# HDIPTV_ISP=mobile

# 自动按省取源：默认开，按识别结果去取本省公开的运营商单播清单，
# 只给频道模板里的央视 / 卫视补线路。面板「运行设置」里的开关优先。
# 写 0 关闭；湖北移动会跳过（项目已内置清单），广电宽带没有公开单播清单也跳过。
HDIPTV_AUTO_REGION=1

# NAS 上的端口，被占用就换一个
HOST_PORT=9797

# 数据目录。留空则用 compose 文件旁边的 ./config 和 ./output。
# 飞牛 / 群晖建议写绝对路径，例如：
# CONFIG_DIR=/vol2/1000/docker/hd-iptv/config
# OUTPUT_DIR=/vol2/1000/docker/hd-iptv/output
CONFIG_DIR=./config
OUTPUT_DIR=./output

# 对外访问地址。留空即可：服务端按请求的域名端口现拼，内网访问拿内网地址，
# 套了反代（Lucky / Nginx）外网访问拿外网地址，两边都能直接播。
# 只有当反代不透传 Host 头时才需要手填，例如 PUBLIC_URL=https://tv.example.com:8443
PUBLIC_URL=

# 访问密码。设了之后面板和订阅地址都得带这一段：
#   https://域名:9797/你设的密码/
#   https://域名:9797/你设的密码/playlist.m3u
# 不带就只显示「身份认证失败」，局域网也一样。留空 = 不设密码。
# 只用字母数字和 - _ . ，别带斜杠和空格。
HDIPTV_SECRET=

# 自动刷新间隔（小时）。面板上也能改，改完立刻生效。
# 别调太勤：每轮要把每个台各取一次清单，上游按出口 IP 限频，跑太勤会把自己限死。
# 播放地址在播放时会按需重新换票，列表过期也不影响观看，24 小时够用。
HDIPTV_INTERVAL_HOURS=24

# 画质区间：720 起步（只有 720P 的台也留着），上限 2160。
# 芒果、浙江广电这些官方源常常只给 4K 一路，卡在 1080 会把唯一能用的地址
# 整条丢掉，退到 1 Mbps 的中转空壳上——那才是卫视卡顿的根源。
# 这一项优先级高于 config.toml，改配置文件没用时先看这里。
HDIPTV_MIN_HEIGHT=720
HDIPTV_MAX_HEIGHT=2160

# 播放方式：direct = 清单由本机下发、分片播放器直连 CDN（默认，最流畅）；
# proxy = 分片也经 NAS 转发。实测全转发时 NAS 去拉分片会被平台回 403，
# 只有个别播放器直连放不出来时才需要切 proxy。
HDIPTV_PLAY_MODE=direct

# 分片中转缓存上限（MB）。只对 proxy 模式生效，多台设备同看一个台时共用。0 关闭。
HDIPTV_RELAY_CACHE_MB=96

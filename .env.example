# 复制成 .env 后按需改，docker compose 会自动读。
# 不改也能跑，下面都是默认值。

# NAS 上的端口，被占用就换一个
HOST_PORT=9797

# 数据目录。留空则用 compose 文件旁边的 ./config 和 ./output。
# 飞牛 / 群晖建议写绝对路径，例如：
# CONFIG_DIR=/vol2/1000/docker/hd-iptv/config
# OUTPUT_DIR=/vol2/1000/docker/hd-iptv/output
CONFIG_DIR=./config
OUTPUT_DIR=./output

# 必填：NAS 的局域网地址。
# 列表里的播放地址用它拼成本机转发地址（/live/xxx.m3u8），播放器才不会因为
# 不被上游认的 UA 而放不出来。留空则退回上游直连地址，VLC 这类播放器多半放不了。
PUBLIC_URL=http://192.168.1.10:9797

# 自动刷新间隔（小时）
HDIPTV_INTERVAL_HOURS=3

# 画质区间：720 起步（只有 720P 的台也留着），上限放到 2160 以便源里有 4K 时取 4K。
# 上游本身只有 1080P 的话，这里写多少都不会凭空多出 4K。
HDIPTV_MIN_HEIGHT=720
HDIPTV_MAX_HEIGHT=2160

# 分片中转缓存上限（MB）。多台设备同时看同一个台时共用缓存，只向上游取一次；
# 上游对同一 IP 的请求频率敏感，这个缓存越小越容易被限流。0 表示关闭缓存。
HDIPTV_RELAY_CACHE_MB=96
